{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ローカル開発用。デプロイには使わない。本番の設定は obsttorte setup が生成する
  "name": "obsttorte",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 10000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  "access": {
    "dev": { "aud": "local-development-only" }
  },
  "triggers": {
    "crons": ["17 3 * * *", "41 4 * * 1"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obsttorte",
      "database_id": "local-development-only",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "obsttorte" }],
  "ratelimits": [
    {
      "name": "AUTH_FAILURE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "ACCESS_AUD": "",
    "ACCESS_TOKEN_EXPIRES_AT": ""
  }
}
